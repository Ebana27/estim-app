<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Enable static compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    
    <!-- MIME Types for PWA -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
    </staticContent>

    <!-- HTTP Headers for PWA -->
    <httpProtocol>
      <customHeaders>
        <!-- Service Worker -->
        <add name="Service-Worker-Allowed" value="/" />
        
        <!-- CORS -->
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, OPTIONS" />
        
        <!-- Security -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="no-referrer" />
        
        <!-- Cache Control for Service Worker -->
        <add name="Cache-Control" value="max-age=3600, must-revalidate" />
      </customHeaders>
    </httpProtocol>

    <!-- Static Files Cache Policy -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="31.00:00:00" />
    </staticContent>

    <!-- Service Worker and Manifest specific cache -->
    <location path="sw.js">
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:01:00" />
      </staticContent>
    </location>
    
    <location path="manifest.json">
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </location>

    <!-- URL Rewrite for SPA -->
    <rewrite>
      <rules>
        <!-- Don't rewrite files that exist -->
        <rule name="Static Files" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="Directories" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>
        
        <!-- Rewrite to index.html for SPA routes -->
        <rule name="SPA" stopProcessing="true">
          <match url="^(?!\.well-known).*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/(api|assets)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
